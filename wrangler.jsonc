{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krathong-txt",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "RIVER", "class_name": "River" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["River"] }],
  "routes": [{ "pattern": "krathong-txt.marqotone.space", "custom_domain": true }],
  "observability": { "enabled": true }
}
